#version 330 core
// Полноэкранный треугольник без вершинного буфера: три вершины считаются
// из gl_VertexID (0,1,2) и накрывают весь экран с запасом. Один большой
// треугольник вместо двух — без диагонального шва и чуть дешевле.
out vec2 TexCoords;

void main() {
    vec2 pos = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
    TexCoords = pos;                         // 0..2 -> при выборке даёт 0..1 по экрану
    gl_Position = vec4(pos * 2.0 - 1.0, 0.0, 1.0);
}
